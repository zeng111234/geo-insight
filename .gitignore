# 数据库是运行产物，由 seed 或导入通道重新生成，不入库
*.db
*.db-journal
*.db-wal
*.db-shm
# 归档出来的旧库快照（geo.db.archive-2026-11-12 这种）
geo.db.*

# 导入失败报告
import_reports/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 应用卡（工具生成，含本机绝对路径，可再生）
.wbapp_*.genie

# 渠道密钥与浏览器登录态（本地私有，绝不入库）
# .browser-profiles/ 不带路径前缀：实际位置在 backend/src/ 下（与 sohu 现存
# 登录态一致），写死 backend/ 前缀会漏掉，登录 cookie 有被提交的风险
backend/data/*.local.json
# start-team.bat 的共享密码文件（批处理 call 用，非 JSON）
backend/data/team.local.bat
# backup-team.bat 的整库快照（同事机器上的运行时产物）
backend/backups/
.browser-profiles/

# Reasonix 会话状态
.reasonix/

# ZCode 会话状态与发布 draft 运行产物(可再生)
.zcode/
backend/data/publish_drafts/
# 采集原始响应：每次采集一段完整平台 JSON，一天几百个文件。
# 是"事后复核"的存档（answer.raw_uri 指向这里），属于运行产物，不入库。
backend/data/raw/
